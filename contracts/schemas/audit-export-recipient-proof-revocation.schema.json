{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dataground:schema:audit-export-recipient-proof-revocation:v1",
  "title": "DataGround audit export recipient proof revocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "content", "contentSha256", "revocationTrustProfileSha256", "signature"],
  "properties": {
    "contract": { "const": "dataground.audit-export-recipient-proof-revocation/ed25519/v1" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "isolationDomainId",
        "scope",
        "proofingAuthorityId",
        "proofingTrustProfileSha256",
        "reasonSha256",
        "revocationAuthorityId",
        "issuedAt",
        "effectiveAt"
      ],
      "properties": {
        "contract": { "const": "dataground.audit-export-recipient-proof-revocation/v1" },
        "isolationDomainId": { "type": "string", "pattern": "^iso_[0-9a-z]{20,32}$" },
        "scope": { "enum": ["profile", "key"] },
        "proofingAuthorityId": { "$ref": "#/$defs/partyId" },
        "proofingTrustProfileSha256": { "$ref": "#/$defs/sha256" },
        "proofingSigningKeyId": { "$ref": "#/$defs/keyId" },
        "reasonSha256": { "$ref": "#/$defs/sha256" },
        "revocationAuthorityId": { "$ref": "#/$defs/partyId" },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "effectiveAt": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "key" } } },
          "then": { "required": ["proofingSigningKeyId"] },
          "else": { "not": { "required": ["proofingSigningKeyId"] } }
        }
      ]
    },
    "contentSha256": { "$ref": "#/$defs/sha256" },
    "revocationTrustProfileSha256": { "$ref": "#/$defs/sha256" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "keyId", "signature"],
      "properties": {
        "contract": {
          "const": "dataground.audit-export-recipient-proof-revocation-signature/ed25519/v1"
        },
        "keyId": { "$ref": "#/$defs/keyId" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  },
  "$defs": {
    "keyId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "partyId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
