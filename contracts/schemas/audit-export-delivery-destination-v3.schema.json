{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dataground:schema:audit-export-delivery-destination:s3-mtls-workload:v3",
  "title": "DataGround workload-authorized audit export S3 delivery destination",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "deliveryId",
    "isolationDomainId",
    "recipientId",
    "transportContract",
    "endpoint",
    "bucket",
    "addressingStyle",
    "objectKey",
    "clientCertificateSha256",
    "serverTrustSha256",
    "workloadId",
    "workloadIdentityGrantSha256",
    "workloadIdentityGeneration"
  ],
  "properties": {
    "contract": { "const": "dataground.audit-export-delivery-destination/s3-mtls-workload/v3" },
    "deliveryId": { "type": "string", "pattern": "^adl_[0-9a-z]{20,32}$" },
    "isolationDomainId": { "type": "string", "pattern": "^iso_[0-9a-z]{20,32}$" },
    "recipientId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "transportContract": {
      "const": "dataground.audit-export-transport/s3-immutable-mtls-workload/v3"
    },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "minLength": 1,
      "maxLength": 2048
    },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"
    },
    "addressingStyle": { "enum": ["path", "virtual-hosted"] },
    "objectKey": {
      "type": "string",
      "pattern": "^audit-export-deliveries/v1/iso_[0-9a-z]{20,32}/adl_[0-9a-z]{20,32}/[0-9a-f]{64}\\.json$"
    },
    "clientCertificateSha256": { "$ref": "#/$defs/sha256" },
    "serverTrustSha256": { "$ref": "#/$defs/sha256" },
    "workloadId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "workloadIdentityGrantSha256": { "$ref": "#/$defs/sha256" },
    "workloadIdentityGeneration": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
