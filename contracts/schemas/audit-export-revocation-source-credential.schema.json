{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dataground:schema:audit-export-revocation-source-credential:v2",
  "title": "DataGround audit export revocation source credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "isolationDomainId",
    "purpose",
    "sourceId",
    "sourceRegistrySha256",
    "endpoint",
    "activatedAt",
    "expiresAt",
    "bearerToken"
  ],
  "properties": {
    "contract": {
      "const": "dataground.audit-export-revocation-source-credential/v2"
    },
    "isolationDomainId": { "type": "string", "pattern": "^iso_[0-9a-z]{20,32}$" },
    "purpose": { "enum": ["recipient-proof", "workload-identity"] },
    "sourceId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "sourceRegistrySha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "endpoint": { "enum": ["notice", "trust"] },
    "activatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "bearerToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9._~+/=-]+$"
    }
  }
}
