index 0000000000000000000000000000000000000000..2f693e2b4c9e48fa58a5a04b9455cd6523419f98
--- /dev/null
+++ b/crates/openshell-driver-docker/src/retained_workspace.rs
@@ -0,0 +1,307 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 DataGround contributors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Retained read of one stopped, unmounted workspace in the Docker writable layer.
+
+use super::*;
+use bollard::models::{MountPoint, MountPointTypeEnum, RestartPolicyNameEnum};
+use bollard::query_parameters::ContainerArchiveInfoOptionsBuilder;
+use serde::Serialize;
+use std::io::Read as _;
+
+const RECORD_FILE: &str = "workspace-retention.json";
+const MAX_RECORD_BYTES: u64 = 4096;
+const MAX_ARCHIVE_BYTES: usize = 32 << 20;
+const WORKSPACE: &str = "/sandbox/workspace";
+const GO_MODE_DIR: u32 = 1 << 31;
+const GO_MODE_SYMLINK: u32 = 1 << 27;
+
+#[derive(Serialize, PartialEq, Eq)]
+struct Hold {
+    version: u8,
+    generation: String,
+    container: String,
+    started_at: String,
+    finished_at: String,
+}
+
+fn unavailable() -> Status {
+    Status::failed_precondition("stopped Docker workspace could not be confirmed")
+}
+
+fn record_path(config: &DockerDriverRuntimeConfig, id: &str) -> Result<PathBuf, Status> {
+    if id.is_empty()
+        || id.len() > 128
+        || !id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+    {
+        return Err(Status::invalid_argument("invalid Docker sandbox identity"));
+    }
+    Ok(docker_boundary_state_dir_by_id(id, config)?.join(RECORD_FILE))
+}
+
+// Presence, including a malformed record, fences lifecycle mutations.
+pub(super) fn require_unheld(config: &DockerDriverRuntimeConfig, id: &str) -> Result<(), Status> {
+    match std::fs::symlink_metadata(record_path(config, id)?) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        _ => Err(Status::failed_precondition(
+            "Docker workspace is held for retention",
+        )),
+    }
+}
+
+fn publish_hold(path: &Path, hold: &Hold) -> Result<(), Status> {
+    let encoded = serde_json::to_vec(hold).map_err(|_| unavailable())?;
+    if encoded.len() as u64 > MAX_RECORD_BYTES {
+        return Err(unavailable());
+    }
+    match std::fs::symlink_metadata(path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            image_update::durable_write(path, &encoded)?;
+        }
+        Ok(info) if info.is_file() && info.len() <= MAX_RECORD_BYTES => {
+            let file = std::fs::File::open(path).map_err(|_| unavailable())?;
+            let mut existing = Vec::new();
+            (&file)
+                .take(MAX_RECORD_BYTES + 1)
+                .read_to_end(&mut existing)
+                .map_err(|_| unavailable())?;
+            if existing != encoded {
+                return Err(unavailable());
+            }
+            // A previous caller may have lost its acknowledgement at publication.
+            file.sync_all().map_err(|_| unavailable())?;
+            let parent = path.parent().ok_or_else(unavailable)?;
+            std::fs::File::open(parent)
+                .and_then(|dir| dir.sync_all())
+                .map_err(|_| unavailable())?;
+        }
+        _ => return Err(unavailable()),
+    }
+    Ok(())
+}
+
+impl DockerComputeDriver {
+    /// Acquire the durable retention hold and copy one exact stopped generation.
+    /// The caller supplies the original generation from the trusted lifecycle
+    /// record and is responsible for workspace authorization. The hold survives
+    /// an unsuccessful read, a dropped response and a driver restart.
+    pub async fn retain_stopped_workspace_archive(
+        &self,
+        workspace: &str,
+        sandbox_id: &str,
+        sandbox_name: &str,
+        generation: &str,
+    ) -> Result<Vec<u8>, Status> {
+        if workspace.is_empty() || sandbox_id.is_empty() || sandbox_name.is_empty() {
+            return Err(Status::invalid_argument(
+                "exact Docker workspace and sandbox are required",
+            ));
+        }
+        openshell_core::sandbox_generation::SandboxGenerationId::parse(generation.to_string())
+            .map_err(|_| Status::invalid_argument("exact Docker generation is required"))?;
+        let path = record_path(&self.config, sandbox_id)?;
+        tokio::time::timeout(
+            Duration::from_secs(60),
+            Box::pin(async {
+                let _lifecycle = self
+                    .image_update_gates
+                    .gate_for(sandbox_id)
+                    .lock_owned()
+                    .await;
+                image_update::require_settled(&self.config, sandbox_id)?;
+                if self.config.workspace_storage != workspace::Storage::WritableLayer
+                    || self
+                        .pending_snapshot(sandbox_id, sandbox_name)
+                        .await?
+                        .is_some()
+                {
+                    return Err(unavailable());
+                }
+                let descriptor = read_docker_runtime_descriptor(sandbox_id, &self.config)
+                    .await
+                    .map_err(|_| unavailable())?
+                    .ok_or_else(unavailable)?;
+                let container_id = descriptor
+                    .resource_claims
+                    .get("docker.container_id")
+                    .filter(|id| {
+                        id.len() == 64 && id.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+                    })
+                    .ok_or_else(unavailable)?;
+                if descriptor.boundary_id != sandbox_id || descriptor.generation != generation {
+                    return Err(unavailable());
+                }
+                let before = self
+                    .observe_retained_workspace(
+                        workspace,
+                        sandbox_id,
+                        sandbox_name,
+                        generation,
+                        container_id,
+                    )
+                    .await?;
+                publish_hold(&path, &before)?;
+                let archive = read_archive(&self.docker, container_id).await?;
+                if self
+                    .observe_retained_workspace(
+                        workspace,
+                        sandbox_id,
+                        sandbox_name,
+                        generation,
+                        container_id,
+                    )
+                    .await?
+                    != before
+                {
+                    return Err(unavailable());
+                }
+                Ok(archive)
+            }),
+        )
+        .await
+        .map_err(|_| Status::deadline_exceeded("stopped Docker workspace read timed out"))?
+    }
+
+    async fn observe_retained_workspace(
+        &self,
+        workspace: &str,
+        sandbox_id: &str,
+        sandbox_name: &str,
+        generation: &str,
+        container_id: &str,
+    ) -> Result<Hold, Status> {
+        let container = self
+            .find_managed_container_summary(sandbox_id, sandbox_name)
+            .await
+            .map_err(|_| unavailable())?
+            .ok_or_else(unavailable)?;
+        if container.id.as_deref() != Some(container_id)
+            || container
+                .labels
+                .as_ref()
+                .and_then(|labels| labels.get(LABEL_SANDBOX_WORKSPACE))
+                .map(String::as_str)
+                != Some(workspace)
+        {
+            return Err(unavailable());
+        }
+        let inspected = self
+            .docker
+            .inspect_container(container_id, None)
+            .await
+            .map_err(|_| unavailable())?;
+        if inspected.id.as_deref() != Some(container_id)
+            || inspected
+                .mounts
+                .as_ref()
+                .is_none_or(|mounts| !driver_owned_mounts(&self.config, sandbox_id, mounts))
+        {
+            return Err(unavailable());
+        }
+        let host = inspected.host_config.as_ref().ok_or_else(unavailable)?;
+        if host.auto_remove != Some(false)
+            || host.tmpfs.as_ref().is_some_and(|mounts| !mounts.is_empty())
+            || host
+                .volumes_from
+                .as_ref()
+                .is_some_and(|mounts| !mounts.is_empty())
+            || !matches!(
+                host.restart_policy.as_ref().and_then(|policy| policy.name),
+                Some(RestartPolicyNameEnum::NO | RestartPolicyNameEnum::EMPTY)
+            )
+        {
+            return Err(unavailable());
+        }
+        let state = inspected.state.as_ref().ok_or_else(unavailable)?;
+        if state.status != Some(ContainerStateStatusEnum::EXITED)
+            || state.running != Some(false)
+            || state.restarting != Some(false)
+            || state.paused != Some(false)
+            || state.pid != Some(0)
+        {
+            return Err(unavailable());
+        }
+        let (Some(started_at), Some(finished_at)) =
+            (state.started_at.as_ref(), state.finished_at.as_ref())
+        else {
+            return Err(unavailable());
+        };
+        if started_at.is_empty() || finished_at.is_empty() {
+            return Err(unavailable());
+        }
+        Ok(Hold {
+            version: 1,
+            generation: generation.into(),
+            container: container_id.into(),
+            started_at: started_at.clone(),
+            finished_at: finished_at.clone(),
+        })
+    }
+}
+
+fn driver_owned_mounts(
+    config: &DockerDriverRuntimeConfig,
+    id: &str,
+    mounts: &[MountPoint],
+) -> bool {
+    mounts.iter().all(|mount| {
+        let name = match mount.destination.as_deref() {
+            Some(BOUNDARY_MOUNT_PATH) => docker_channel_volume_name_by_id(id, config),
+            Some(BOUNDARY_CONTROL_MOUNT_PATH) => docker_control_volume_name_by_id(id, config),
+            _ => return false,
+        };
+        mount.typ == Some(MountPointTypeEnum::VOLUME) && mount.name.as_deref() == Some(&name)
+    })
+}
+
+async fn read_archive(docker: &Docker, container_id: &str) -> Result<Vec<u8>, Status> {
+    // Docker resolves intermediate symlinks when opening the archive path.
+    // Check both directory components while the workload is held stopped.
+    for (path, name) in [("/sandbox", "sandbox"), (WORKSPACE, "workspace")] {
+        let info = docker
+            .get_container_archive_info(
+                container_id,
+                Some(
+                    ContainerArchiveInfoOptionsBuilder::default()
+                        .path(path)
+                        .build(),
+                ),
+            )
+            .await
+            .map_err(|_| unavailable())?;
+        if info.name != name
+            || !info.link_target.is_empty()
+            || info.file_mode & (GO_MODE_DIR | GO_MODE_SYMLINK) != GO_MODE_DIR
+        {
+            return Err(unavailable());
+        }
+    }
+    let options = DownloadFromContainerOptionsBuilder::default()
+        .path(WORKSPACE)
+        .build();
+    let mut stream = docker.download_from_container(container_id, Some(options));
+    let mut archive = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        let chunk = chunk.map_err(|_| unavailable())?;
+        if chunk.len() > MAX_ARCHIVE_BYTES - archive.len() {
+            return Err(Status::resource_exhausted(
+                "stopped Docker workspace archive exceeds the limit",
+            ));
+        }
+        archive.extend_from_slice(&chunk);
+    }
+    if archive.len() < 1024
+        || archive.len() % 512 != 0
+        || archive[archive.len() - 1024..]
+            .iter()
+            .any(|byte| *byte != 0)
+    {
+        return Err(unavailable());
+    }
+    Ok(archive)
+}
+
+#[cfg(test)]
+mod tests;
