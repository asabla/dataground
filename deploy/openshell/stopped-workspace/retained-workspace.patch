+// SPDX-FileCopyrightText: Copyright (c) 2026 DataGround contributors
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use crate::tests::{runtime_config, test_driver_with_config, test_sandbox, test_workload_identity};
+use openshell_core::SandboxSessionId;
+use openshell_core::proto::compute::v1::{
+    SandboxUpdatePreconditions, UpdateSandboxConfigurationRequest,
+};
+use openshell_sandbox_backend::boundary_protocol::SandboxTransport;
+use std::process::Command;
+
+#[test]
+fn exact_hold_replay_refuses_replacement_and_corruption() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join(RECORD_FILE);
+    let mut hold = Hold {
+        version: 1,
+        generation: "generation-1".into(),
+        container: "container".into(),
+        started_at: "time-1".into(),
+        finished_at: "time-2".into(),
+    };
+    publish_hold(&path, &hold).unwrap();
+    publish_hold(&path, &hold).unwrap();
+    hold.started_at = "time-3".into();
+    assert!(publish_hold(&path, &hold).is_err());
+    std::fs::write(&path, b"partial record").unwrap();
+    assert!(publish_hold(&path, &hold).is_err());
+    assert_eq!(std::fs::read(&path).unwrap(), b"partial record");
+}
+
+#[test]
+fn only_exact_runtime_mounts_are_admitted() {
+    let config = runtime_config();
+    let id = "sandbox-1";
+    let mut mount = MountPoint {
+        typ: Some(MountPointTypeEnum::VOLUME),
+        destination: Some(BOUNDARY_MOUNT_PATH.into()),
+        name: Some(docker_channel_volume_name_by_id(id, &config)),
+        ..Default::default()
+    };
+    assert!(driver_owned_mounts(
+        &config,
+        id,
+        std::slice::from_ref(&mount)
+    ));
+    mount.name = Some("foreign-volume".into());
+    assert!(!driver_owned_mounts(
+        &config,
+        id,
+        std::slice::from_ref(&mount)
+    ));
+    mount.destination = Some("/sandbox".into());
+    assert!(!driver_owned_mounts(&config, id, &[mount]));
+}
+
+struct Fixture {
+    container: String,
+    directory: PathBuf,
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = Command::new("docker")
+            .args(["rm", "--force", &self.container])
+            .output();
+        let _ = std::fs::remove_dir_all(&self.directory);
+    }
+}
+
+fn docker(args: &[&str]) -> String {
+    let output = Command::new("docker").args(args).output().unwrap();
+    assert!(
+        output.status.success(),
+        "Docker {} failed: {}",
+        args[0],
+        String::from_utf8_lossy(&output.stderr)
+    );
+    String::from_utf8(output.stdout).unwrap().trim().to_string()
+}
+
+#[tokio::test]
+#[ignore = "requires an isolated Docker daemon and a digest-pinned fixture image"]
+async fn live_retained_workspace_fences_lifecycle_after_lost_read() {
+    let image = std::env::var("DATAGROUND_STOPPED_WORKSPACE_IMAGE").unwrap();
+    assert!(
+        image.contains("@sha256:"),
+        "fixture image must be digest pinned"
+    );
+    let mut sandbox = test_sandbox();
+    let session_id = SandboxSessionId::new();
+    sandbox.id = session_id.to_string();
+    sandbox.name = format!("retained-workspace-{}", sandbox.id.to_ascii_lowercase());
+    sandbox.workspace = "retention-fixture".into();
+    let mut config = runtime_config();
+    config.sandbox_namespace = sandbox.name.clone();
+    let container = docker(&[
+        "create",
+        "--network",
+        "none",
+        "--restart=no",
+        "--cap-drop",
+        "ALL",
+        "--security-opt",
+        "no-new-privileges",
+        "--pids-limit",
+        "64",
+        "--memory",
+        "256m",
+        "--label",
+        &format!("{LABEL_MANAGED_BY}={LABEL_MANAGED_BY_VALUE}"),
+        "--label",
+        &format!("{LABEL_ISOLATION_BACKEND}={LABEL_ISOLATION_BACKEND_OPEN_SHELL}"),
+        "--label",
+        &format!("{LABEL_ISOLATION_ROLE}={LABEL_ISOLATION_ROLE_SANDBOX}"),
+        "--label",
+        &format!("{LABEL_SANDBOX_ID}={}", sandbox.id),
+        "--label",
+        &format!("{LABEL_SANDBOX_NAME}={}", sandbox.name),
+        "--label",
+        &format!("{LABEL_SANDBOX_WORKSPACE}={}", sandbox.workspace),
+        "--label",
+        &format!("{LABEL_SANDBOX_NAMESPACE}={}", config.sandbox_namespace),
+        "--entrypoint",
+        "/bin/sleep",
+        &image,
+        "infinity",
+    ]);
+    let fixture = Fixture {
+        container,
+        directory: prepare_docker_boundary_state_dir(&sandbox, &config).unwrap(),
+    };
+    docker(&["start", &fixture.container]);
+    docker(&[
+        "exec",
+        &fixture.container,
+        "/bin/sh",
+        "-c",
+        "mkdir -p /sandbox/workspace && printf 'changed\\000\\376' >/sandbox/workspace/file.bin",
+    ]);
+    let generation = "generation-1";
+    let descriptor = SandboxRuntimeDescriptor {
+        boundary_id: sandbox.id.clone(),
+        generation: generation.into(),
+        session_id,
+        workload_identity: test_workload_identity(),
+        transport: SandboxTransport::Unix {
+            socket_path: BOUNDARY_SOCKET_MOUNT_PATH.into(),
+        },
+        tls: SandboxTlsClientConfig {
+            server_name: "fixture".into(),
+            trust_anchor_pem: "fixture".into(),
+        },
+        host_gateway_ip: None,
+        resource_claims: [("docker.container_id".into(), fixture.container.clone())].into(),
+        provisioning_evidence: isolation::provisioning_evidence(&fixture.container, generation)
+            .unwrap(),
+    };
+    image_update::durable_write(
+        &fixture.directory.join(RUNTIME_DESCRIPTOR_FILE),
+        &serde_json::to_vec(&descriptor).unwrap(),
+    )
+    .unwrap();
+    let mut driver = test_driver_with_config(config.clone());
+    driver.docker = Arc::new(Docker::connect_with_local_defaults().unwrap());
+    let read = |driver: &DockerComputeDriver, generation: &'static str| {
+        let driver = driver.clone();
+        let sandbox = sandbox.clone();
+        async move {
+            driver
+                .retain_stopped_workspace_archive(
+                    &sandbox.workspace,
+                    &sandbox.id,
+                    &sandbox.name,
+                    generation,
+                )
+                .await
+        }
+    };
+    assert!(read(&driver, generation).await.is_err());
+    assert!(!fixture.directory.join(RECORD_FILE).exists());
+    docker(&["stop", "--time", "1", &fixture.container]);
+    assert!(read(&driver, "foreign-generation").await.is_err());
+    let initial = read(&driver, generation).await.unwrap();
+    let mut archive = tar::Archive::new(initial.as_slice());
+    let mut entries = archive.entries().unwrap();
+    assert!(
+        entries
+            .next()
+            .unwrap()
+            .unwrap()
+            .header()
+            .entry_type()
+            .is_dir()
+    );
+    let mut member = entries.next().unwrap().unwrap();
+    assert_eq!(
+        member.path().unwrap().as_ref(),
+        Path::new("workspace/file.bin")
+    );
+    let mut content = Vec::new();
+    member.read_to_end(&mut content).unwrap();
+    assert_eq!(content, b"changed\x00\xfe");
+    assert!(entries.next().is_none());
+
+    let mut replacement = test_driver_with_config(config.clone());
+    replacement.docker = driver.docker.clone();
+    drop(driver);
+    let start = replacement
+        .start_sandbox(&sandbox.id, &sandbox.name, "generation-2", &[], None)
+        .await
+        .unwrap_err();
+    assert_eq!(start.message(), "Docker workspace is held for retention");
+    let delete = ComputeDriver::delete_sandbox(
+        &replacement,
+        Request::new(DeleteSandboxRequest {
+            sandbox_id: sandbox.id.clone(),
+            name: sandbox.name.clone(),
+        }),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(delete.message(), start.message());
+    let create = ComputeDriver::create_sandbox(
+        &replacement,
+        Request::new(CreateSandboxRequest {
+            sandbox: Some(sandbox.clone()),
+            ..Default::default()
+        }),
+    )
+    .await
+    .unwrap_err();
+    assert_eq!(create.message(), start.message());
+    config.workspace_storage = workspace::Storage::Persistent;
+    let update = test_driver_with_config(config)
+        .update_workload_image(&UpdateSandboxConfigurationRequest {
+            preconditions: Some(SandboxUpdatePreconditions {
+                sandbox_id: sandbox.id.clone(),
+                name: sandbox.name.clone(),
+                revision: 1,
+                operation_id: "854cf4f7-46b5-4202-bac1-d6a26b8c0001".into(),
+                expected_image: "original".into(),
+                image: "replacement".into(),
+                ..Default::default()
+            }),
+            ..Default::default()
+        })
+        .await
+        .unwrap_err();
+    assert_eq!(update.message(), start.message());
+    assert_eq!(read(&replacement, generation).await.unwrap(), initial);
+
+    // The daemon owner can bypass the driver. A new boot cannot replay the old hold.
+    docker(&["start", &fixture.container]);
+    docker(&["stop", "--time", "1", &fixture.container]);
+    assert!(read(&replacement, generation).await.is_err());
+}
