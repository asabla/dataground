+// SPDX-FileCopyrightText: Copyright (c) 2026 DataGround contributors
+// SPDX-License-Identifier: Apache-2.0
+
+//! Private, authenticated stopped workspace delivery.
+
+#![allow(clippy::result_large_err)]
+
+use std::pin::Pin;
+use std::sync::Arc;
+use std::time::Duration;
+
+use bytes::Bytes;
+use futures::{Stream, stream};
+use openshell_core::compute::MAX_STOPPED_WORKSPACE_ARCHIVE_BYTES;
+use openshell_core::proto::{
+    ReadStoppedWorkspaceFrame, ReadStoppedWorkspaceRequest, StoppedWorkspaceArchiveHeader,
+    read_stopped_workspace_frame::Payload, workspace_retention_server::WorkspaceRetention,
+};
+use openshell_core::sandbox_generation::SandboxGenerationId;
+use openshell_ocsf::ResourceDetails;
+use sha2::{Digest, Sha256};
+use tokio::sync::{Semaphore, SemaphorePermit};
+use tokio::time::Instant;
+use tonic::{Request, Response, Status};
+
+use crate::ServerState;
+use crate::auth::audit;
+use crate::auth::identity::IdentityProvider;
+use crate::auth::principal::Principal;
+use crate::auth::workspace_authz::{
+    MinWorkspaceRole, authorize_workspace_membership, selected_workspace_name,
+};
+
+pub(crate) const PATH_PREFIX: &str = "/openshell.v1.WorkspaceRetention/";
+const CHUNK_BYTES: usize = 64 << 10;
+const READ_TIMEOUT: Duration = Duration::from_secs(60);
+static READS: Semaphore = Semaphore::const_new(4);
+
+#[derive(Clone)]
+pub(crate) struct WorkspaceRetentionService {
+    state: Arc<ServerState>,
+}
+
+impl WorkspaceRetentionService {
+    pub(crate) fn new(state: Arc<ServerState>) -> Self {
+        Self { state }
+    }
+}
+
+#[tonic::async_trait]
+impl WorkspaceRetention for WorkspaceRetentionService {
+    type ReadStoppedWorkspaceStream =
+        Pin<Box<dyn Stream<Item = Result<ReadStoppedWorkspaceFrame, Status>> + Send>>;
+
+    async fn read_stopped_workspace(
+        &self,
+        request: Request<ReadStoppedWorkspaceRequest>,
+    ) -> Result<Response<Self::ReadStoppedWorkspaceStream>, Status> {
+        let principal = super::extract_principal(&request)?;
+        // Local development can assign a synthetic User upstream. A private
+        // archive always requires a verified identity and explicit membership.
+        if !matches!(&principal, Principal::User(user)
+            if user.identity.provider != IdentityProvider::LocalDev)
+        {
+            return Err(Status::permission_denied(
+                "authenticated workspace administrator required",
+            ));
+        }
+        let req = request.into_inner();
+        let workspace = selected_workspace_name(req.workspace_scope.as_ref())?;
+        if req.sandbox_id.is_empty()
+            || req.sandbox_id.len() > 128
+            || !req
+                .sandbox_id
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+        {
+            return Err(Status::invalid_argument("exact sandbox ID is required"));
+        }
+        let generation = SandboxGenerationId::parse(req.generation)
+            .map_err(|_| Status::invalid_argument("exact runtime generation is required"))?;
+        let deadline = Instant::now() + READ_TIMEOUT;
+        let (archive, permit) = tokio::time::timeout_at(deadline, async {
+            authorize(&self.state, &principal, workspace).await?;
+            audit::record_target(ResourceDetails::named("workspace", workspace));
+            audit::record_target(ResourceDetails::new("sandbox", &req.sandbox_id));
+            let permit = READS
+                .try_acquire()
+                .map_err(|_| Status::resource_exhausted("stopped workspace reads are busy"))?;
+            let archive = self
+                .state
+                .compute
+                .read_stopped_workspace(
+                    workspace,
+                    &req.sandbox_id,
+                    &generation,
+                    authorize(&self.state, &principal, workspace),
+                )
+                .await?;
+            // Membership may have been revoked while Docker was reading.
+            authorize(&self.state, &principal, workspace).await?;
+            Ok::<_, Status>((archive, permit))
+        })
+        .await
+        .map_err(|_| timed_out())??;
+        if !(1024..=MAX_STOPPED_WORKSPACE_ARCHIVE_BYTES).contains(&archive.len())
+            || archive.len() % 512 != 0
+        {
+            return Err(Status::failed_precondition(
+                "driver returned an invalid stopped workspace archive",
+            ));
+        }
+        Ok(Response::new(archive_stream(archive, permit, deadline)))
+    }
+}
+
+async fn authorize(
+    state: &ServerState,
+    principal: &Principal,
+    workspace: &str,
+) -> Result<(), Status> {
+    authorize_workspace_membership(&state.store, principal, workspace, MinWorkspaceRole::Admin)
+        .await
+        .map(|_| ())
+        .map_err(|error| {
+            if error.code() == tonic::Code::PermissionDenied {
+                Status::not_found("sandbox not found")
+            } else {
+                error
+            }
+        })
+}
+
+fn timed_out() -> Status {
+    Status::deadline_exceeded("stopped workspace read timed out")
+}
+
+fn archive_stream(
+    archive: Vec<u8>,
+    permit: SemaphorePermit<'static>,
+    deadline: Instant,
+) -> <WorkspaceRetentionService as WorkspaceRetention>::ReadStoppedWorkspaceStream {
+    let header = StoppedWorkspaceArchiveHeader {
+        size_bytes: archive.len() as u64,
+        digest: format!("sha256:{:x}", Sha256::digest(&archive)),
+    };
+    let state = (Bytes::from(archive), Some(header), permit);
+    Box::pin(stream::try_unfold(
+        state,
+        move |(mut bytes, header, permit)| async move {
+            if Instant::now() >= deadline {
+                return Err(timed_out());
+            }
+            let payload = if let Some(header) = header {
+                Payload::Header(header)
+            } else if bytes.is_empty() {
+                return Ok(None);
+            } else {
+                Payload::Data(bytes.split_to(CHUNK_BYTES.min(bytes.len())))
+            };
+            Ok(Some((
+                ReadStoppedWorkspaceFrame {
+                    payload: Some(payload),
+                },
+                (bytes, None, permit),
+            )))
+        },
+    ))
+}
