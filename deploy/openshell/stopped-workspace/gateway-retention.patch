+// SPDX-FileCopyrightText: Copyright (c) 2026 DataGround contributors
+// SPDX-License-Identifier: Apache-2.0
+
+use super::*;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use openshell_core::compute::StoppedWorkspaceReader;
+use openshell_core::proto::{
+    Sandbox, SandboxPhase, WorkspaceMember, WorkspaceRole, datamodel::v1::ObjectMeta,
+    workspace_retention_client::WorkspaceRetentionClient, workspace_selector,
+};
+use tokio::net::TcpListener;
+use tokio::sync::Notify;
+use tonic::Code;
+use tonic::transport::Channel;
+
+use crate::auth::audit::ConnectionSource;
+use crate::auth::identity::Identity;
+use crate::auth::sandbox_session::RUNTIME_GENERATION_ANNOTATION;
+use crate::grpc::test_support::test_server_state;
+use crate::multiplex::MultiplexService;
+use crate::persistence::ObjectType;
+
+const ID: &str = "sandbox-retained";
+const GENERATION: &str = "generation-1";
+const SUBJECT: &str = "retention-admin";
+
+#[derive(Default)]
+struct Reader {
+    calls: AtomicUsize,
+    held: AtomicBool,
+    fail_next: AtomicBool,
+    pause: AtomicBool,
+    entered: Notify,
+    proceed: Notify,
+}
+
+#[tonic::async_trait]
+impl StoppedWorkspaceReader for Reader {
+    fn require_workspace_unheld(&self, _sandbox_id: &str) -> Result<(), Status> {
+        if self.held.load(Ordering::SeqCst) {
+            return Err(Status::failed_precondition("workspace held"));
+        }
+        Ok(())
+    }
+
+    async fn read_stopped_workspace(
+        &self,
+        workspace: &str,
+        sandbox_id: &str,
+        sandbox_name: &str,
+        generation: &str,
+    ) -> Result<Vec<u8>, Status> {
+        assert_eq!(
+            (workspace, sandbox_id, sandbox_name, generation),
+            ("default", ID, "retained", GENERATION)
+        );
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        self.held.store(true, Ordering::SeqCst);
+        if self.fail_next.swap(false, Ordering::SeqCst) {
+            return Err(Status::unavailable("archive response lost"));
+        }
+        if self.pause.load(Ordering::SeqCst) {
+            self.entered.notify_one();
+            self.proceed.notified().await;
+        }
+        Ok(archive_bytes())
+    }
+}
+
+fn archive_bytes() -> Vec<u8> {
+    vec![0x5a; CHUNK_BYTES + 512]
+}
+
+async fn fixture(reader: Arc<Reader>) -> Arc<ServerState> {
+    let mut state = test_server_state().await;
+    let mutable = Arc::get_mut(&mut state).unwrap();
+    mutable.config.mtls_auth.enabled = true;
+    mutable.compute = mutable
+        .compute
+        .clone()
+        .with_stopped_workspace_reader(Some(reader));
+    for workspace in ["default", "foreign"] {
+        state
+            .store
+            .put_message(&WorkspaceMember {
+                metadata: Some(ObjectMeta {
+                    id: uuid::Uuid::new_v4().to_string(),
+                    name: SUBJECT.into(),
+                    workspace: workspace.into(),
+                    ..Default::default()
+                }),
+                principal_subject: SUBJECT.into(),
+                role: WorkspaceRole::Admin.into(),
+            })
+            .await
+            .unwrap();
+    }
+    let mut sandbox = Sandbox {
+        metadata: Some(ObjectMeta {
+            id: ID.into(),
+            name: "retained".into(),
+            workspace: "default".into(),
+            annotations: [(RUNTIME_GENERATION_ANNOTATION.into(), GENERATION.into())].into(),
+            ..Default::default()
+        }),
+        ..Default::default()
+    };
+    sandbox.set_phase(SandboxPhase::Stopped.into());
+    state.store.put_message(&sandbox).await.unwrap();
+    state
+}
+
+fn request(workspace: &str, generation: &str) -> ReadStoppedWorkspaceRequest {
+    ReadStoppedWorkspaceRequest {
+        workspace_scope: Some(workspace_selector(workspace)),
+        sandbox_id: ID.into(),
+        generation: generation.into(),
+    }
+}
+
+// Feed the multiplexer the identity produced by a verified TLS handshake. The
+// fixture exercises real gRPC transport, authorization, and persistence.
+async fn client(
+    state: &Arc<ServerState>,
+    subject: Option<&str>,
+) -> WorkspaceRetentionClient<Channel> {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let multiplexer = MultiplexService::new(state.clone());
+    let identity = subject.map(|subject| Identity {
+        subject: subject.into(),
+        display_name: None,
+        roles: Vec::new(),
+        scopes: Vec::new(),
+        provider: IdentityProvider::Mtls,
+    });
+    tokio::spawn(async move {
+        let (socket, remote) = listener.accept().await.unwrap();
+        multiplexer
+            .serve_with_peer_identity(socket, identity, ConnectionSource::Peer(remote))
+            .await
+            .unwrap();
+    });
+    WorkspaceRetentionClient::connect(format!("http://{address}"))
+        .await
+        .unwrap()
+}
+
+#[tokio::test]
+async fn retains_exact_generation_across_gateway_failures_and_retries() {
+    let reader = Arc::new(Reader::default());
+    let state = fixture(reader.clone()).await;
+    let mut local_dev = Request::new(request("default", GENERATION));
+    local_dev
+        .extensions_mut()
+        .insert(Principal::User(crate::auth::principal::UserPrincipal {
+            identity: Identity {
+                subject: SUBJECT.into(),
+                display_name: None,
+                roles: Vec::new(),
+                scopes: Vec::new(),
+                provider: IdentityProvider::LocalDev,
+            },
+        }));
+    assert_eq!(
+        WorkspaceRetentionService::new(state.clone())
+            .read_stopped_workspace(local_dev)
+            .await
+            .err()
+            .expect("local-dev identity rejected")
+            .code(),
+        Code::PermissionDenied
+    );
+    let mut anonymous = client(&state, None).await;
+    assert_eq!(
+        anonymous
+            .read_stopped_workspace(request("default", GENERATION))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::Unauthenticated
+    );
+    let mut nonmember = client(&state, Some("nonmember")).await;
+    assert_eq!(
+        nonmember
+            .read_stopped_workspace(request("default", GENERATION))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::NotFound
+    );
+    let mut authorized = client(&state, Some(SUBJECT)).await;
+    assert_eq!(
+        authorized
+            .read_stopped_workspace(request("foreign", GENERATION))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::NotFound
+    );
+    assert_eq!(
+        authorized
+            .read_stopped_workspace(request("default", "generation-2"))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::FailedPrecondition
+    );
+    assert_eq!(reader.calls.load(Ordering::SeqCst), 0);
+
+    reader.fail_next.store(true, Ordering::SeqCst);
+    assert_eq!(
+        authorized
+            .read_stopped_workspace(request("default", GENERATION))
+            .await
+            .unwrap_err()
+            .code(),
+        Code::Unavailable
+    );
+    let restart = state
+        .compute
+        .start_sandbox("default", "retained")
+        .await
+        .unwrap_err();
+    assert_eq!(restart.message(), "workspace held");
+    let delete = state
+        .compute
+        .delete_sandbox_by_id(ID, "retained")
+        .await
+        .unwrap_err();
+    assert_eq!(delete.message(), "workspace held");
+
+    let mut interrupted = authorized
+        .read_stopped_workspace(request("default", GENERATION))
+        .await
+        .unwrap()
+        .into_inner();
+    let first = interrupted.message().await.unwrap().unwrap();
+    drop(interrupted);
+    let mut retry = authorized
+        .read_stopped_workspace(request("default", GENERATION))
+        .await
+        .unwrap()
+        .into_inner();
+    assert_eq!(retry.message().await.unwrap(), Some(first.clone()));
+    let Some(Payload::Header(header)) = first.payload else {
+        panic!("expected archive header")
+    };
+    let mut received = Vec::new();
+    while let Some(frame) = retry.message().await.unwrap() {
+        let Some(Payload::Data(chunk)) = frame.payload else {
+            panic!("expected archive data")
+        };
+        assert!(!chunk.is_empty() && chunk.len() <= CHUNK_BYTES);
+        received.extend_from_slice(&chunk);
+    }
+    assert_eq!(received, archive_bytes());
+    assert_eq!(header.size_bytes, received.len() as u64);
+    assert_eq!(
+        header.digest,
+        format!("sha256:{:x}", Sha256::digest(&received))
+    );
+    assert_eq!(reader.calls.load(Ordering::SeqCst), 3);
+    assert!(reader.held.load(Ordering::SeqCst));
+}
+
+#[tokio::test]
+async fn revocation_during_read_withholds_archive_and_keeps_hold() {
+    let reader = Arc::new(Reader::default());
+    reader.pause.store(true, Ordering::SeqCst);
+    let state = fixture(reader.clone()).await;
+    let mut authorized = client(&state, Some(SUBJECT)).await;
+    let attempt = tokio::spawn(async move {
+        authorized
+            .read_stopped_workspace(request("default", GENERATION))
+            .await
+    });
+    tokio::time::timeout(Duration::from_secs(5), reader.entered.notified())
+        .await
+        .unwrap();
+    state
+        .store
+        .delete_by_name(WorkspaceMember::object_type(), "default", SUBJECT)
+        .await
+        .unwrap();
+    reader.proceed.notify_one();
+    assert_eq!(attempt.await.unwrap().unwrap_err().code(), Code::NotFound);
+    assert!(reader.held.load(Ordering::SeqCst));
+}
