new file mode 100644
index 0000000000000000000000000000000000000000..2b37b3bbe93517dd1eedf261ff2b513fd1fe3e78
--- /dev/null
+++ b/proto/workspace_retention.proto
@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 DataGround contributors
+// SPDX-License-Identifier: Apache-2.0
+
+syntax = "proto3";
+
+package openshell.v1;
+
+import "datamodel.proto";
+import "options.proto";
+
+// Private gateway contract for the stopped workspace candidate.
+service WorkspaceRetention {
+  // Acquire or recover the durable hold, then stream a stopped Docker archive.
+  rpc ReadStoppedWorkspace(ReadStoppedWorkspaceRequest)
+      returns (stream ReadStoppedWorkspaceFrame) {
+    option (openshell.options.v1.authorization) = {
+      auth_mode: "bearer"
+      scope: "sandbox:write"
+      workspace_role: "admin"
+    };
+  }
+}
+
+message ReadStoppedWorkspaceRequest {
+  openshell.datamodel.v1.WorkspaceSelector workspace_scope = 1;
+  // Stable ID of the original sandbox from the trusted lifecycle record.
+  string sandbox_id = 2;
+  // Exact runtime generation from the same record.
+  string generation = 3;
+}
+
+message ReadStoppedWorkspaceFrame {
+  // A successful stream has one header followed by all contiguous data bytes.
+  oneof payload {
+    StoppedWorkspaceArchiveHeader header = 1;
+    bytes data = 2;
+  }
+}
+
+message StoppedWorkspaceArchiveHeader {
+  uint64 size_bytes = 1;
+  // sha256: followed by 64 lowercase hexadecimal digits.
+  string digest = 2;
+}
