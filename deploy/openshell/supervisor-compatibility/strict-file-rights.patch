+// Landlock directory rights do not describe access to a single file. Inspect
+// the same opened inode used by the rule, so path replacement cannot substitute
+// its type. Keep strict kernel/ABI enforcement and all meaningful file rights.
+fn rule_for_open_path(
+    path_fd: PathFd,
+    access: BitFlags<AccessFs>,
+    abi: ABI,
+) -> Result<PathBeneath<PathFd>> {
+    let file = std::fs::File::from(path_fd.as_fd().try_clone_to_owned().into_diagnostic()?);
+    let access = if file.metadata().into_diagnostic()?.is_dir() {
+        access
+    } else {
+        access & AccessFs::from_file(abi)
+    };
+    Ok(PathBeneath::new(path_fd, access))
+}
