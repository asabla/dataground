{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataground.dev/schemas/openshell-runtime-diagnostic-v1.json",
  "title": "DataGround local OpenShell runtime diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "certificationEligible", "profile", "run", "checks", "cleanup", "result"],
  "properties": {
    "schemaVersion": {"const": "dataground.dev.openshell-runtime-diagnostic/v1"},
    "certificationEligible": {"const": false},
    "profile": {"$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/profile"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resources", "startedAt", "finishedAt", "origin", "sourceCommit", "model"],
      "properties": {
        "id": {"type":"string", "pattern":"^[a-f0-9]{32}$"},
        "resources": {"$ref":"https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/run/properties/resources"},
        "startedAt": {"$ref":"https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/timestamp"},
        "finishedAt": {"$ref":"https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/timestamp"},
        "origin": {"const":"local"},
        "sourceCommit": {"$ref":"https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/commit"},
        "model": {"type":"string", "pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
      }
    },
    "checks": {"$ref":"https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/checks"},
    "cleanup": {"$ref":"https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/cleanup"},
    "result": {"const":"passed"}
  }
}
