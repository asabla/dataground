{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataground.dev/schemas/openshell-canary-scan-v1.json",
  "title": "DataGround OpenShell commitment-only canary scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surface",
    "canaryCommitment",
    "status",
    "matches",
    "complete",
    "inputLimitBytes",
    "inspectedBytes",
    "candidates",
    "startedAt",
    "finishedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dataground.dev.openshell-canary-scan/v1"
    },
    "surface": {
      "enum": [
        "sandbox-process",
        "sandbox-environment",
        "sandbox-filesystem",
        "provider-arguments",
        "gateway-logs",
        "sandbox-logs",
        "runtime-errors"
      ]
    },
    "canaryCommitment": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["clear", "matched", "incomplete"]
    },
    "matches": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "boolean"
    },
    "inputLimitBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "inspectedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "integer",
      "minimum": 0
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "clear" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "matches": { "const": 0 },
          "complete": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "matched" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "matches": { "type": "integer", "minimum": 1 },
          "complete": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "incomplete" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "complete": { "const": false }
        }
      }
    }
  ]
}
