{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataground.dev/schemas/openshell-credential-non-exposure-evidence-v2.json",
  "title": "DataGround OpenShell credential non-exposure evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "run", "checks", "cleanup", "result"],
  "properties": {
    "schemaVersion": {
      "const": "dataground.dev.openshell-credential-non-exposure-evidence/v2"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openshellCommit",
        "gatewayImage",
        "supervisorImage",
        "sandboxImage",
        "providerProfileSourceSHA256",
        "runtimeVersion",
        "gatewayEndpoint",
        "driver",
        "composeSHA256",
        "gatewayConfigSHA256"
      ],
      "properties": {
        "openshellCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "gatewayImage": { "$ref": "#/$defs/imageDigest" },
        "supervisorImage": { "$ref": "#/$defs/imageDigest" },
        "sandboxImage": { "$ref": "#/$defs/imageDigest" },
        "providerProfileSourceSHA256": { "$ref": "#/$defs/sha256" },
        "runtimeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "gatewayEndpoint": { "const": "http://127.0.0.1:8080" },
        "driver": { "const": "docker" },
        "composeSHA256": { "$ref": "#/$defs/sha256" },
        "gatewayConfigSHA256": { "$ref": "#/$defs/sha256" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resources",
        "startedAt",
        "finishedAt",
        "verifier",
        "canaryCommitment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gateway", "sandbox", "provider", "runtime", "workspace"],
          "properties": {
            "gateway": { "$ref": "#/$defs/resourceName" },
            "sandbox": { "$ref": "#/$defs/resourceName" },
            "provider": { "$ref": "#/$defs/providerName" },
            "runtime": { "$ref": "#/$defs/resourceName" },
            "workspace": { "$ref": "#/$defs/workspaceName" }
          }
        },
        "startedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "finishedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "dataground-openshell-canary" },
            "version": { "const": "2.0.0" }
          }
        },
        "canaryCommitment": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "surface",
          "runID",
          "resource",
          "canaryCommitment",
          "inputCommitment",
          "status",
          "matches",
          "complete",
          "inputLimitBytes",
          "inspectedBytes",
          "candidates",
          "startedAt",
          "finishedAt"
        ],
        "properties": {
          "schemaVersion": {
            "const": "dataground.dev.openshell-canary-scan/v1"
          },
          "surface": {
            "enum": [
              "sandbox-process",
              "sandbox-environment",
              "sandbox-filesystem",
              "provider-arguments",
              "gateway-logs",
              "sandbox-logs",
              "runtime-errors"
            ]
          },
          "runID": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name"],
            "properties": {
              "kind": {
                "enum": ["gateway", "sandbox", "provider", "runtime"]
              },
              "name": { "$ref": "#/$defs/resourceName" }
            }
          },
          "canaryCommitment": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "inputCommitment": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "status": { "const": "clear" },
          "matches": { "const": 0 },
          "complete": { "const": true },
          "inputLimitBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 268435456
          },
          "inspectedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "candidates": {
            "type": "integer",
            "minimum": 0
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandbox", "providerBinding", "workspace"],
      "properties": {
        "sandbox": { "$ref": "#/$defs/cleanupReceipt" },
        "providerBinding": { "$ref": "#/$defs/providerCleanupReceipt" },
        "workspace": { "$ref": "#/$defs/workspaceCleanupReceipt" }
      }
    },
    "result": { "const": "passed" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    },
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "workspaceName": {
      "type": "string",
      "pattern": "^dg-canary-[a-f0-9]{32}$"
    },
    "providerName": {
      "type": "string",
      "pattern": "^dg-canary-provider-[a-f0-9]{32}$"
    },
    "cleanupReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/resourceName" },
        "status": { "const": "removed" }
      }
    },
    "providerCleanupReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/providerName" },
        "status": { "const": "removed" }
      }
    },
    "workspaceCleanupReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "$ref": "#/$defs/workspaceName" },
        "status": { "const": "removed" }
      }
    }
  }
}
