{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataground.dev/schemas/openshell-runtime-diagnostic-v5.json",
  "title": "DataGround local strict supervisor candidate runtime diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "certificationEligible",
    "profile",
    "run",
    "checks",
    "cleanup",
    "result",
    "candidateCredentialCheck",
    "policySource",
    "supervisorCandidate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dataground.dev.openshell-runtime-diagnostic/v5"
    },
    "certificationEligible": {
      "const": false
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openshellCommit",
        "gatewayImage",
        "supervisorImage",
        "sandboxImage",
        "runtimeVersion",
        "runtimeSchemaCanonicalSHA256",
        "gatewayEndpoint",
        "driver",
        "composeSHA256",
        "gatewayConfigSHA256",
        "runtimePolicySHA256"
      ],
      "properties": {
        "openshellCommit": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/commit"
        },
        "gatewayImage": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/imageDigest"
        },
        "supervisorImage": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sandboxImage": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtimeVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "runtimeSchemaCanonicalSHA256": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/sha256"
        },
        "gatewayEndpoint": {
          "const": "http://127.0.0.1:8080"
        },
        "driver": {
          "const": "docker"
        },
        "composeSHA256": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/sha256"
        },
        "gatewayConfigSHA256": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/sha256"
        },
        "runtimePolicySHA256": {
          "const": "a1d56c0470c3264c4c37183352d783ebb67911d92ef2eb6ec5f7c76c61f69f39"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resources",
        "startedAt",
        "finishedAt",
        "origin",
        "sourceCommit",
        "model"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "resources": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/run/properties/resources"
        },
        "startedAt": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/timestamp"
        },
        "origin": {
          "const": "local"
        },
        "sourceCommit": {
          "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/$defs/commit"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "checks": {
      "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/checks"
    },
    "cleanup": {
      "$ref": "https://dataground.dev/schemas/openshell-runtime-conformance-evidence-v2.json#/properties/cleanup"
    },
    "result": {
      "const": "passed"
    },
    "candidateCredentialCheck": {
      "const": "passed"
    },
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "compilerSourceCommit",
        "inputSHA256"
      ],
      "properties": {
        "profile": {
          "const": "rosetta-development/v1"
        },
        "compilerSourceCommit": {
          "const": "320158f1e4a4eea378d82c1527f4a7af5fb9855b"
        },
        "inputSHA256": {
          "const": "b2895b9172c50ba7a5fdf574cebdf6789258cc8ce9f90ce5ad8f2b1ff0a825ab"
        }
      }
    },
    "supervisorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "sourceCommit",
        "patchSHA256"
      ],
      "properties": {
        "profile": {
          "const": "openshell-supervisor-candidate/v1"
        },
        "sourceCommit": {
          "const": "d556748771c41cbbd4e4dd7cd9030c798afe2b7d"
        },
        "patchSHA256": {
          "const": "5e97724dd9d9e7fad9abed8a46b9a4d6e06979119998c411daf34b2423056057"
        }
      }
    }
  }
}
