{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataground.dev/schemas/openshell-runtime-conformance-acceptance-v1.json",
  "title": "DataGround OpenShell runtime conformance acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidence",
    "workflow",
    "artifact"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dataground.dev.openshell-runtime-conformance-acceptance/v1"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "runID"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^deploy/openshell/evidence/openshell-runtime-conformance-v[0-9]+\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runID": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "runID",
        "headCommit"
      ],
      "properties": {
        "path": {
          "const": ".github/workflows/openshell-runtime-conformance.yml"
        },
        "runID": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "headCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id",
        "archiveDigest"
      ],
      "properties": {
        "name": {
          "const": "openshell-runtime-conformance"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "archiveDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
