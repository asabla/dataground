{
  "$extensions": { "org.dataground.density": "compact" },
  "density": {
    "$type": "dimension",
    "controlHeight": { "$value": { "value": 2.25, "unit": "rem" } },
    "rowPadding": { "$value": { "value": 1, "unit": "rem" } },
    "sectionGap": { "$value": { "value": 1, "unit": "rem" } },
    "panelPadding": { "$value": { "value": 1.25, "unit": "rem" } },
    "panelHeaderHeight": { "$value": { "value": 4, "unit": "rem" } }
  }
}
