{
  "$extensions": {
    "org.dataground.formatVersion": "2025.10"
  },
  "palette": {
    "$type": "color",
    "neutral": {
      "000": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "050": {
        "$value": { "colorSpace": "srgb", "components": [0.957, 0.965, 0.973], "hex": "#f4f6f8" }
      },
      "100": {
        "$value": { "colorSpace": "srgb", "components": [0.902, 0.929, 0.961], "hex": "#e6edf5" }
      },
      "300": {
        "$value": { "colorSpace": "srgb", "components": [0.796, 0.835, 0.875], "hex": "#cbd5df" }
      },
      "400": {
        "$value": { "colorSpace": "srgb", "components": [0.608, 0.659, 0.722], "hex": "#9ba8b8" }
      },
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.435, 0.49, 0.565], "hex": "#6f7d90" }
      },
      "600": {
        "$value": { "colorSpace": "srgb", "components": [0.361, 0.408, 0.459], "hex": "#5c6875" }
      },
      "700": {
        "$value": { "colorSpace": "srgb", "components": [0.149, 0.196, 0.267], "hex": "#263244" }
      },
      "800": {
        "$value": { "colorSpace": "srgb", "components": [0.071, 0.11, 0.165], "hex": "#121c2a" }
      },
      "900": {
        "$value": { "colorSpace": "srgb", "components": [0.051, 0.078, 0.125], "hex": "#0d1420" }
      },
      "950": {
        "$value": { "colorSpace": "srgb", "components": [0.031, 0.051, 0.086], "hex": "#080d16" }
      },
      "1000": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } }
    },
    "cyan": {
      "400": {
        "$value": { "colorSpace": "srgb", "components": [0.349, 0.722, 0.89], "hex": "#59b8e3" }
      },
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.231, 0.655, 0.847], "hex": "#3ba7d8" }
      },
      "700": {
        "$value": { "colorSpace": "srgb", "components": [0.031, 0.494, 0.678], "hex": "#087ead" }
      },
      "800": {
        "$value": { "colorSpace": "srgb", "components": [0.02, 0.396, 0.549], "hex": "#05658c" }
      },
      "900": {
        "$value": { "colorSpace": "srgb", "components": [0.02, 0.204, 0.286], "hex": "#053449" }
      }
    },
    "amber": {
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.843, 0.604, 0.208], "hex": "#d79a35" }
      },
      "700": {
        "$value": { "colorSpace": "srgb", "components": [0.478, 0.31, 0], "hex": "#7a4f00" }
      },
      "900": {
        "$value": { "colorSpace": "srgb", "components": [0.165, 0.129, 0.082], "hex": "#2a2115" }
      }
    },
    "green": {
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.31, 0.737, 0.545], "hex": "#4fbc8b" }
      },
      "700": {
        "$value": { "colorSpace": "srgb", "components": [0.09, 0.42, 0.302], "hex": "#176b4d" }
      },
      "900": {
        "$value": { "colorSpace": "srgb", "components": [0.051, 0.188, 0.137], "hex": "#0d3023" }
      }
    },
    "red": {
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.941, 0.443, 0.471], "hex": "#f07178" }
      },
      "700": {
        "$value": { "colorSpace": "srgb", "components": [0.655, 0.184, 0.239], "hex": "#a72f3d" }
      },
      "900": {
        "$value": { "colorSpace": "srgb", "components": [0.22, 0.082, 0.09], "hex": "#381517" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 0.25, "unit": "rem" } },
    "2": { "$value": { "value": 0.5, "unit": "rem" } },
    "3": { "$value": { "value": 0.75, "unit": "rem" } },
    "4": { "$value": { "value": 1, "unit": "rem" } },
    "5": { "$value": { "value": 1.5, "unit": "rem" } },
    "6": { "$value": { "value": 2, "unit": "rem" } },
    "7": { "$value": { "value": 3, "unit": "rem" } },
    "8": { "$value": { "value": 5, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 0.5, "unit": "rem" } },
    "panel": { "$value": { "value": 0.5, "unit": "rem" } },
    "round": { "$value": { "value": 999, "unit": "px" } }
  },
  "border": {
    "$type": "dimension",
    "default": { "$value": { "value": 0.0625, "unit": "rem" } },
    "strong": { "$value": { "value": 0.125, "unit": "rem" } }
  },
  "font": {
    "family": {
      "interface": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
      },
      "data": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": { "value": 0.625, "unit": "rem" } },
      "body": { "$value": { "value": 0.875, "unit": "rem" } },
      "heading": { "$value": { "value": 1.25, "unit": "rem" } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 0, "unit": "ms" } },
      "fast": { "$value": { "value": 120, "unit": "ms" } },
      "standard": { "$value": { "value": 180, "unit": "ms" } }
    }
  },
  "layer": {
    "$type": "number",
    "base": { "$value": 0 },
    "popover": { "$value": 20 },
    "dialog": { "$value": 30 },
    "toast": { "$value": 40 }
  }
}
